# ============================================================
# Live2D AI Companion — Environment Configuration Template
# All settings can also be managed directly from the Web UI Settings Modal (⚙️)
# ============================================================

# Server Host & Port (Default: 0.0.0.0:8800)
PORT=8800
HOST=0.0.0.0

# ------------------------------------------------------------
# AI Brain Configuration
# ------------------------------------------------------------
# Provider: 'openai' (default), 'claude', or 'gemini'
AI_PROVIDER=openai

# OpenAI / OpenAI-Compatible Endpoint (e.g. LM Studio, Ollama, Groq, OpenRouter, vLLM)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.75

# Anthropic Claude API Key (if using claude provider)
ANTHROPIC_API_KEY=

# Google Gemini API Key (if using gemini provider)
GEMINI_API_KEY=

# ------------------------------------------------------------
# Voice & Text-to-Speech (TTS)
# ------------------------------------------------------------
# Master Toggle: true | false
TTS_MASTER_ENABLED=true

# Engine: 'omnivoice' | 'edge-tts'
TTS_ENGINE=omnivoice
OMNIVOICE_API_URL=http://localhost:8000
TTS_ALLOW_FALLBACK=true
EDGE_VOICE=ja-JP-NanamiNeural

# ------------------------------------------------------------
# Optional External Bot Bridges
# ------------------------------------------------------------
# Telegram Bot
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_ID=

# Discord Bot
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_ID=
